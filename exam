clear all;

img = imread("img1.jpg");
img = rgb2gray(img);
binary = imbinarize(img);

se = strel('line',10, 10);

dilated = imdilate(binary, se);
erode = imerode(binary,se);

custom_str = strel([0 1 0; 1 1 1; 0 1 0]);
dil_cust = imdilate(binary,custom_str);
erode_cust = imerode(binary,custom_str);

figure('Name','Morph');
subplot(2,3,1), imshow(binary), title('Binary Image');
subplot(2,3,2), imshow(dilated), title('Dilated Image');
subplot(2,3,3), imshow(erode), title('Eroded Image');
subplot(2,3,4), imshow(dil_cust), title('Custom Dilated Image');
subplot(2,3,5), imshow(erode_cust), title('Custom Eroded Image');


