clear all;
img = imread("img1.jpg");
img = rgb2gray(img);

avg_gaussian_kernel = fspecial('gaussian', [5,5], 1.0);

lpf = imfilter(img, avg_gaussian_kernel);

filter_hpf = fspecial("laplacian",0.2);
hpf = imfilter(img, filter_hpf);

sobel = edge(img, 'sobel');
prewitt = edge(img, 'prewitt');
canny = edge(img, 'canny');

figure ('Name', 'HPF&LPF')
subplot(2,3,1); imshow(img);              title('Original Gray');
subplot(2,3,2); imshow(lpf);              title('LPF (Gaussian)');
subplot(2,3,3); imshow(mat2gray(hpf));    title('HPF (Laplacian)');
subplot(2,3,4); imshow(sobel);        title('Sobel');
subplot(2,3,5); imshow(prewitt);      title('Prewitt');
subplot(2,3,6); imshow(canny);        title('Canny');

