clear;
clear all;

img1 = imread("img1.jpg");
img2 = imread("img2.jpg");

img1 = imresize(img1, [256, 256]);
img2 = imresize(img2, [256, 256]);

img1_gray = rgb2gray(img1);
img2_gray = rgb2gray(img2);
figure('Name','Arithemetic OPs')
subplot(4,4,1); imshow(img1_gray); title('img1 gray');
subplot(4,4,2); imshow(img2_gray); title('img2 gray');


A = im2double(img1_gray);
B = im2double(img2_gray);

add_img = imadd(img1_gray,img2_gray);
sub_img = imsubtract(img1_gray,img2_gray);
mul_img = immultiply(A,B);
div_img = imdivide(A,B);

com_img = imcomplement(img1_gray);
or_img = bitor(img1_gray,img2_gray);
and_img = bitand(img1_gray,img2_gray);
xor_img = bitxor(img1_gray,img2_gray);

subplot(4,4,3); imshow(add_img); title('add');
subplot(4,4,4); imshow(sub_img); title('sub');
subplot(4,4,5); imshow(mul_img); title('mul');
subplot(4,4,6); imshow(div_img); title('div');
subplot(4,4,8); imshow(com_img); title('complement');
subplot(4,4,9); imshow(or_img); title('or');
subplot(4,4,10); imshow(and_img); title('and');
subplot(4,4,11); imshow(xor_img); title('xor');

