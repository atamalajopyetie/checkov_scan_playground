Gray = rgb2gray(imread('image.jpg'));

%--- GLCM ---
glcm  = graycomatrix(Gray, 'Offset', [0 1; -1 1; -1 0; -1 -1]);
stats = graycoprops(glcm, {'contrast','correlation','energy','homogeneity'});
% Access: stats.Contrast, stats.Energy, etc.

%--- LBP (built-in) ---
lbpFeatures = extractLBPFeatures(Gray);
% Returns a 1D feature vector (59 elements for default uniform mapping)

%--- LBP (manual) ---
[rows, cols] = size(Gray);
lbpImage = zeros(rows, cols);
for i = 2:rows-1
    for j = 2:cols-1
        center = Gray(i,j);
        neighbors = [Gray(i-1,j-1), Gray(i-1,j), Gray(i-1,j+1), ...
                     Gray(i,j+1), Gray(i+1,j+1), Gray(i+1,j), ...
                     Gray(i+1,j-1), Gray(i,j-1)];
        bits = neighbors >= center;
        lbpImage(i,j) = sum(bits .* [128,64,32,16,8,4,2,1]);
    end
end

